package chikoski:png-glitch@0.1.0;

interface glitch {
  /// Why a call failed. No call traps on bad input.
  variant glitch-error {
    /// The bytes are a PNG signature but not a decodable PNG; the message says why.
    invalid-image(string),
    /// The bytes are not a PNG (a WebP or an unknown signature). WebP is not supported yet.
    unsupported-format,
    /// The recipe does not parse or fails validation; the message says why.
    invalid-recipe(string),
    /// The image exceeds the decode limits (64 million pixels, 256 MiB decompressed).
    too-large,
    /// `apply` was called on a session without a recipe (see `set-recipe`).
    no-recipe,
    /// The encoding is not supported: only 8-bit gray, gray-alpha, rgb and rgba for now.
    unsupported-encoding,
  }

  enum param-kind { float, int, %enum, strategy }

  enum format { png, webp }

  record param-info {
    /// Name as written in the recipe and in `-f name:key=value`.
    name: string,
    kind: param-kind,
    min: option<f64>,
    max: option<f64>,
    /// `none` means the parameter is required.
    default: option<string>,
    /// Valid values of an `enum` parameter, empty otherwise.
    choices: list<string>,
    doc: string,
  }

  record filter-info {
    /// Kebab-case name, as in `-f`.
    name: string,
    /// PascalCase `type:` value in a recipe.
    yaml-type: string,
    aliases: list<string>,
    doc: string,
    example: string,
    formats: list<format>,
    params: list<param-info>,
    deprecated: bool,
  }

  /// Every built-in filter with its parameters, ranges and defaults.
  list-filters: func() -> list<filter-info>;

  /// Checks a recipe without an image.
  validate-recipe: func(recipe: string) -> result<_, glitch-error>;

  /// Applies `recipe` to the PNG `image`. `recipe` is the YAML or JSON of the CLI's `--config`
  /// file; steps may use `rows` and `rect` but not `mask`. The same image, recipe and seed
  /// always give the same bytes.
  glitch: func(image: list<u8>, recipe: string, seed: u64) -> result<list<u8>, glitch-error>;
}

/// A resident PNG model for live use: the scan lines stay in memory, the recipe is parsed once,
/// and compression happens only in `snapshot`.
interface live {
  use glitch.{glitch-error};

  enum color-type { gray, gray-alpha, rgb, rgba }

  enum filter-type { none, sub, up, average, paeth }

  variant filter-strategy {
    /// Every row uses this filter type.
    fixed(filter-type),
    /// Row `y` uses `pattern[y % len]`; must not be empty.
    pattern(list<filter-type>),
    /// libpng's heuristic. About ten times the cost of a fixed filter: avoid it in a live loop.
    adaptive,
  }

  record encoding {
    color-type: color-type,
    /// Only 8 is supported; other values give `unsupported-encoding`.
    bit-depth: u8,
    filter: filter-strategy,
  }

  /// How each frame is seeded by `apply`.
  enum seed-mode {
    /// The same seed for every frame.
    fixed,
    /// Frame n uses a seed derived from `seed` and n (SplitMix64, `frame_seed` in the Rust API).
    per-frame,
  }

  resource session {
    /// From a real PNG file. `reload-pixels` is not available on such a session.
    from-png: static func(png: list<u8>) -> result<session, glitch-error>;
    /// From RGBA8 pixels (`width * height * 4` bytes): only the PNG encoder's filter step runs.
    from-pixels: static func(width: u32, height: u32, rgba: list<u8>, enc: encoding) -> result<session, glitch-error>;
    /// Refills the model with the next frame and discards earlier glitches.
    reload-pixels: func(rgba: list<u8>) -> result<_, glitch-error>;

    /// Parses `recipe` (the format of `glitch`) once and keeps it. `apply` runs it.
    set-recipe: func(recipe: string, seed: u64, mode: seed-mode) -> result<_, glitch-error>;
    /// Runs the recipe on the current scan lines. Parses nothing.
    apply: func() -> result<_, glitch-error>;
    /// Restores the model as it was after the last `from-png`, `from-pixels` or `reload-pixels`.
    reset: func() -> result<_, glitch-error>;

    /// The current frame as RGBA8 (`width * height * 4` bytes), equal to decoding `snapshot`.
    render-rgba: func() -> result<list<u8>, glitch-error>;
    /// The current frame as a real PNG file (compression runs here).
    snapshot: func() -> result<list<u8>, glitch-error>;
  }
}

world png-glitch {
  export glitch;
  export live;
}
